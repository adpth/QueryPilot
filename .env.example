# Model used by the agent
QP_MODEL=gpt-4o-mini
OPENAI_API_KEY=

# Benchmark databases (SQLite files from Spider or BIRD dev split)
QP_DB_DIR=./benchmarks/databases

# Safety limits applied to every generated query
QP_SQL_TIMEOUT_S=10
QP_MAX_ROWS=500
QP_MAX_REPAIRS=3

# CI regression gate: fail if execution accuracy drops more than this (points)
QP_ACCURACY_TOLERANCE=2.0
